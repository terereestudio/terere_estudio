# Caché: imágenes, videos y audio 30 días; CSS y JS 1 día (no llevan versión en el nombre)
/img/*
  Cache-Control: public, max-age=2592000
/video/*
  Cache-Control: public, max-age=2592000
/audio/*
  Cache-Control: public, max-age=2592000
/css/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400
